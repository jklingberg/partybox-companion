{
  "name": "partybox-companion",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // GitHub CLI and Node.js (for Claude Code and Codex CLI)
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nodeGypDependencies": false
    }
  },

  // UV_LINK_MODE=copy avoids hardlink failures when the uv cache is on a
  // different filesystem than the workspace (common with volume mounts).
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  // uv tool installs land in ~/.local/bin — add it to PATH so pre-commit
  // is available to git hooks without a full shell reload.
  //
  // CLAUDE_CONFIG_DIR relocates Claude Code's credentials, config, and session
  // history into the persistent volume mounted below, so logins and resumable
  // sessions survive container rebuilds.
  //
  // GH_TOKEN is sourced from the host so the gh CLI can reach the GitHub API
  // (the forwarded SSH agent only covers git-over-SSH, not the API). From a
  // host shell: export GH_TOKEN=$(gh auth token). Under cdesktop the wrapper
  // answers it with the host's own `gh auth login` (see the secrets list
  // below) and, with it, gives git a credential helper and the host's commit
  // identity, so a container session is the same GitHub user as a host one.
  // Empty if the host has neither.
  //
  // OPENAI_API_KEY is likewise sourced from the host for Codex CLI, in case
  // API-key auth is used instead of the browser-based ChatGPT OAuth login.
  // Empty if unset on host.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  },

  // Named volumes keep CLI state across container rebuilds: Claude Code
  // (OAuth credentials, .claude.json, projects/<session>.jsonl history) and
  // Codex CLI (~/.codex/auth.json, config.toml).
  "mounts": [
    "source=partybox-claude-config,target=/home/vscode/.claude,type=volume",
    "source=partybox-codex-config,target=/home/vscode/.codex,type=volume"
  ],

  "customizations": {
    // Which host secrets agent-platform's cdesktop wrapper may hand the agent
    // (see remoteEnv above); it forwards only names listed here. GH_TOKEN is
    // the one name it does not read from its secrets file: it asks git on the
    // host for the github.com credential instead, i.e. the host's
    // `gh auth login`.
    "agent-platform": {
      "secrets": ["GH_TOKEN"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "Anthropic.claude-code",
        "SingularityInc.claude-notifier",
        "github.vscode-github-actions"
      ],
      "settings": {
        // Point VS Code at the uv-managed virtual environment
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",

        // Don't auto-run `source .venv/bin/activate` in every new integrated
        // terminal. All commands in this repo are invoked via `uv run ...`
        // (see CLAUDE.md), which doesn't need an activated shell, and
        // activation was occasionally hanging on terminal open.
        "python.terminal.activateEnvironment": false,

        // Disable Pylance type checking — mypy extension handles this
        "python.analysis.typeCheckingMode": "off",

        // Ruff handles both formatting and linting
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        },
        "ruff.enable": true,

        // mypy reads config from the workspace root pyproject.toml
        "mypy-type-checker.args": [
          "--config-file=${containerWorkspaceFolder}/pyproject.toml"
        ],

        // Ruler at 100 columns — matches ruff line-length in pyproject.toml
        "editor.rulers": [100]
      }
    }
  },

  // Runs once after the container is first created. See post-create.sh for the
  // individual steps (volume chown, workspace install, git hooks, Claude Code,
  // Codex CLI).
  "postCreateCommand": "./.devcontainer/post-create.sh",

  "remoteUser": "vscode",

  // The workspace is bind-mounted from the host's ~/projects, which is shared
  // with agent-platform's agent-canvas container (uid 10001). Everything
  // there is group-owned by openhands-shared (gid 2000, setgid dirs) and a
  // default ACL keeps new entries group-writable whatever the writer's umask
  // is. vscode is uid 1000 like the host user, so it already owns most files,
  // but anything the agent created (e.g. .git/objects/xx directories) it can
  // only write through that group. --group-add applies to `docker exec` too,
  // which is how both VS Code and cdesktop enter the container. Requires a
  // container rebuild to take effect.
  //
  // The gid is agent-platform's: docs/fresh-installation.md §4 creates the
  // group and host/apply-projects-acl.sh sets the ACL. Change it there
  // first, then here and in the sibling repositories.
  "runArgs": ["--group-add=2000"]
}
